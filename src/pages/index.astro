---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site';

const crops = [
  {
    icon: '🌾',
    title: 'Fragrant jasmine rice',
    titleKm: 'អង្ករក្រអូប ផ្ការំដួល',
    text: 'Soft, fragrant Phka Rumduol rice. It has won the World’s Best Rice award many times.',
    textKm: 'អង្ករផ្ការំដួល ទន់ និងក្រអូប។ វាបានឈ្នះពានរង្វាន់អង្ករល្អបំផុតលើពិភពលោកជាច្រើនដង។',
  },
  {
    icon: '🌿',
    title: 'Kampot pepper',
    titleKm: 'ម្រេចកំពត',
    text: 'Famous black, red and white pepper from Kampot and Kep, with a protected name (GI).',
    textKm: 'ម្រេចខ្មៅ ក្រហម និងស ដ៏ល្បីពីខេត្តកំពត និងកែប ដែលមានឈ្មោះការពារ (GI)។',
  },
  {
    icon: '🥭',
    title: 'Keo Romeat mango',
    titleKm: 'ស្វាយកែវរមៀត',
    text: 'Sweet, juicy Cambodian mangoes. Delicious fresh, dried, or in a shake.',
    textKm: 'ស្វាយខ្មែរផ្អែម និងមានទឹកច្រើន។ ឆ្ងាញ់ពេលញ៉ាំស្រស់ ស្ងួត ឬក្រឡុក។',
  },
  {
    icon: '🥜',
    title: 'Cashew nuts',
    titleKm: 'គ្រាប់ស្វាយចន្ទី',
    text: 'Cambodia is one of the world’s biggest cashew growers. Crunchy, rich and healthy.',
    textKm: 'កម្ពុជាជាប្រទេសមួយដែលដាំស្វាយចន្ទីច្រើនជាងគេលើពិភពលោក។ ស្រួយ ឆ្ងាញ់ និងល្អសម្រាប់សុខភាព។',
  },
  {
    icon: '🍠',
    title: 'Cassava',
    titleKm: 'ដំឡូងមី',
    text: 'A strong, important crop for food, flour and starch, grown across the country.',
    textKm: 'ដំណាំសំខាន់ និងរឹងមាំ សម្រាប់ធ្វើអាហារ ម្សៅ និងម្សៅដំឡូង ដាំនៅទូទាំងប្រទេស។',
  },
  {
    icon: '🍯',
    title: 'Kampong Speu palm sugar',
    titleKm: 'ស្ករត្នោតកំពង់ស្ពឺ',
    text: 'Natural sugar from the sugar palm tree, Cambodia’s national tree. It also has a protected name (GI).',
    textKm: 'ស្ករធម្មជាតិពីដើមត្នោត ដែលជាដើមឈើជាតិរបស់កម្ពុជា។ វាក៏មានឈ្មោះការពារ (GI) ដែរ។',
  },
];

const values = [
  { icon: '👩‍🌾', label: 'Grown by Khmer farmers', labelKm: 'ដាំដោយកសិករខ្មែរ' },
  { icon: '🌱', label: 'Fresh from the field', labelKm: 'ស្រស់ពីចម្ការ' },
  { icon: '🇰🇭', label: 'Proudly Cambodian', labelKm: 'ផលិតផលខ្មែរ ដោយមោទនភាព' },
];

const steps = [
  {
    icon: '🚜',
    title: 'Farmers grow',
    titleKm: 'កសិករដាំដុះ',
    text: 'Khmer farmers plant and care for the crops, using their skills and knowledge of the land.',
    textKm: 'កសិករខ្មែរដាំ និងថែទាំដំណាំ ដោយប្រើជំនាញ និងចំណេះដឹងអំពីដីរបស់ពួកគេ។',
  },
  {
    icon: '🧺',
    title: 'We collect and check',
    titleKm: 'យើងប្រមូល និងពិនិត្យ',
    text: 'We collect the harvest and check that every crop is clean and good quality.',
    textKm: 'យើងប្រមូលផល ហើយពិនិត្យថាដំណាំនីមួយៗស្អាត និងមានគុណភាពល្អ។',
  },
  {
    icon: '📦',
    title: 'You enjoy it',
    titleKm: 'អ្នករីករាយជាមួយវា',
    text: 'Contact us to buy, and taste the best of Cambodia at home or in your business.',
    textKm: 'ទាក់ទងយើងដើម្បីទិញ ហើយភ្លក់រសជាតិល្អបំផុតរបស់កម្ពុជា នៅផ្ទះ ឬក្នុងអាជីវកម្មរបស់អ្នក។',
  },
];

const faqs = [
  {
    q: 'How can I buy?',
    qKm: 'តើខ្ញុំអាចទិញដោយរបៀបណា?',
    a: 'Send us a message on Telegram or call us. Tell us which crops you want and how much.',
    aKm: 'ផ្ញើសារមកយើងតាម Telegram ឬទូរសព្ទមកយើង។ ប្រាប់យើងថាអ្នកចង់បានដំណាំអ្វី និងចំនួនប៉ុន្មាន។',
  },
  {
    q: 'Can you send to other countries?',
    qKm: 'តើអាចផ្ញើទៅប្រទេសផ្សេងបានទេ?',
    a: 'Please contact us, and we will tell you what is possible for your country.',
    aKm: 'សូមទាក់ទងយើង ហើយយើងនឹងប្រាប់អ្នកពីអ្វីដែលអាចធ្វើបានសម្រាប់ប្រទេសរបស់អ្នក។',
  },
  {
    q: 'What does GI mean?',
    qKm: 'តើ GI មានន័យដូចម្តេច?',
    a: 'GI means “Geographical Indication”. It is a protected name: only pepper grown in the Kampot area can be called Kampot pepper.',
    aKm: 'GI មានន័យថា “សម្គាល់ភូមិសាស្ត្រ”។ វាជាឈ្មោះដែលត្រូវបានការពារ៖ មានតែម្រេចដែលដាំនៅតំបន់កំពតប៉ុណ្ណោះ ទើបអាចហៅថាម្រេចកំពតបាន។',
  },
];
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-brand"></span>
            From the fields of Cambodia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            The best crops of <span class="text-brand">Cambodia.</span>
          </h1>
          <p lang="km" class="mt-4 text-2xl font-semibold text-ink/80">កសិដ្ឋានខ្មែរ · ដំណាំល្អបំផុតរបស់កម្ពុជា</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Fragrant rice, Kampot pepper, sweet mangoes and more, grown with care by Khmer farmers and full of real Cambodian taste.
            <span class="km" lang="km">អង្ករក្រអូប ម្រេចកំពត ស្វាយផ្អែម និងច្រើនទៀត ដាំដោយយកចិត្តទុកដាក់ដោយកសិករខ្មែរ និងមានរសជាតិខ្មែរពិតប្រាកដ។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#crops" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              See our crops → <span lang="km" class="font-khmer font-normal opacity-80">មើលដំណាំ</span>
            </a>
            <a href="#contact" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              Contact us <span lang="km" class="font-khmer font-normal opacity-60">ទាក់ទងយើង</span>
            </a>
          </div>
        </div>

        <!-- Illustration: sunset over Cambodian rice fields, with sugar palms and
             Angkor Wat far away. Drawn in SVG, so it is tiny and stays sharp. -->
        <div class="relative" aria-hidden="true">
          <svg viewBox="0 0 400 400" class="mx-auto block aspect-square w-full max-w-md rounded-[2.5rem] shadow-2xl" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <clipPath id="frame"><rect width="400" height="400" rx="40" /></clipPath>
              <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f0a85a" />
                <stop offset="0.45" stop-color="#f7cf86" />
                <stop offset="1" stop-color="#fcefd2" />
              </linearGradient>
              <radialGradient id="glow">
                <stop offset="0" stop-color="#fff6d8" stop-opacity="0.9" />
                <stop offset="1" stop-color="#fff6d8" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f9dc9c" />
                <stop offset="1" stop-color="#e9b86a" />
              </linearGradient>
            </defs>
            <g clip-path="url(#frame)">
              <!-- Sky, sun and birds -->
              <rect width="400" height="400" fill="url(#sky)" />
              <circle cx="200" cy="168" r="110" fill="url(#glow)" />
              <circle cx="200" cy="168" r="44" fill="#fde7a8" />
              <g fill="none" stroke="#7a4a2a" stroke-width="2" stroke-linecap="round" opacity="0.55">
                <path d="M92 86 q6 -6 12 0 q6 -6 12 0" />
                <path d="M126 70 q4 -4 8 0 q4 -4 8 0" />
                <path d="M290 98 q5 -5 10 0 q5 -5 10 0" />
              </g>

              <!-- Angkor Wat on the horizon -->
              <g fill="#b9784a" opacity="0.5">
                <rect x="150" y="214" width="100" height="14" />
                <rect x="160" y="206" width="80" height="10" />
                <path d="M200 158 C204 178 210 196 213 208 H187 C190 196 196 178 200 158Z" />
                <path d="M174 176 C177 190 181 200 183 208 H165 C167 200 171 190 174 176Z" />
                <path d="M226 176 C229 190 233 200 235 208 H217 C219 200 223 190 226 176Z" />
                <path d="M156 192 C158 200 160 206 162 212 H150 C152 206 154 200 156 192Z" />
                <path d="M244 192 C246 200 248 206 250 212 H238 C240 206 242 200 244 192Z" />
              </g>

              <!-- Distant trees -->
              <path d="M0 234 Q25 226 50 232 Q75 224 100 231 Q125 236 150 230 Q175 225 200 231 Q225 236 250 229 Q275 224 300 231 Q325 235 350 228 Q375 224 400 230 V250 H0Z" fill="#6f8f3e" opacity="0.75" />

              <!-- Sugar palms (Cambodia's national tree) -->
              {[
                { x: 58, top: 120, s: 1 },
                { x: 92, top: 158, s: 0.75 },
                { x: 338, top: 132, s: 0.9 },
              ].map((p) => (
                <g>
                  <path d={`M${p.x} 246 C${p.x - 2} 200 ${p.x + 2} 170 ${p.x} ${p.top}`} stroke="#4a3322" stroke-width={4 * p.s} fill="none" />
                  <g transform={`translate(${p.x} ${p.top}) scale(${p.s})`} stroke="#3f5a22" stroke-width="3.5" stroke-linecap="round">
                    {Array.from({ length: 13 }, (_, i) => {
                      const a = (Math.PI * (i + 0.5)) / 13 + Math.PI;
                      return <line x1="0" y1="0" x2={(Math.cos(a) * 30).toFixed(1)} y2={(Math.sin(a) * 26 + 6).toFixed(1)} />;
                    })}
                  </g>
                </g>
              ))}

              <!-- Rice paddies, with water reflecting the sky -->
              <path d="M0 246 Q100 238 200 246 T400 244 V400 H0Z" fill="#8fbf4d" />
              <path d="M0 262 Q120 254 230 262 T400 260 V276 Q300 270 200 276 T0 274Z" fill="url(#water)" opacity="0.85" />
              <ellipse cx="200" cy="268" rx="36" ry="4" fill="#fff3cf" opacity="0.8" />
              <path d="M0 280 Q140 270 260 282 T400 278 V400 H0Z" fill="#6aa23a" />
              <path d="M0 302 Q100 296 210 304 T400 300 V312 Q300 308 200 314 T0 310Z" fill="url(#water)" opacity="0.6" />
              <path d="M0 318 Q120 306 250 318 T400 314 V400 H0Z" fill="#4d8a2a" />
              <path d="M0 350 Q140 338 260 350 T400 346 V400 H0Z" fill="#3a7a1f" />

              <!-- Rows of young rice -->
              <g stroke="#3f7a22" stroke-width="1.5" stroke-linecap="round" fill="none" opacity="0.7">
                {Array.from({ length: 26 }, (_, i) => {
                  const x = 8 + i * 15.5;
                  const y = 292 + (i % 2) * 3;
                  return <path d={`M${x} ${y} q-3 -4 -5 -7 M${x} ${y} v-8 M${x} ${y} q3 -4 5 -7`} />;
                })}
              </g>

              <!-- Golden rice stalks in front -->
              {Array.from({ length: 11 }, (_, i) => {
                const x = 14 + i * 37 + (i % 2) * 8;
                const h = 58 + (i % 3) * 14;
                const bend = i % 2 ? 16 : -14;
                return (
                  <g>
                    <path d={`M${x} 404 Q${x + bend / 3} ${404 - h / 2} ${x + bend} ${404 - h}`} stroke="#5b8f2a" stroke-width="3" fill="none" />
                    <path d={`M${x} 404 Q${x - 10} ${404 - h / 3} ${x - 18} ${404 - h / 2}`} stroke="#4d8a2a" stroke-width="3" fill="none" />
                    {Array.from({ length: 5 }, (_, j) => (
                      <ellipse
                        cx={x + bend + (bend > 0 ? j * 2.5 : -j * 2.5)}
                        cy={404 - h + j * 7}
                        rx="3.2"
                        ry="5.5"
                        fill={j % 2 ? '#e8b33a' : '#f2c75a'}
                        transform={`rotate(${bend > 0 ? 25 : -25} ${x + bend + (bend > 0 ? j * 2.5 : -j * 2.5)} ${404 - h + j * 7})`}
                      />
                    ))}
                  </g>
                );
              })}
            </g>
          </svg>
          <div class="absolute -top-4 left-2 rotate-[-4deg] rounded-2xl bg-white px-4 py-3 shadow-xl sm:left-6">
            <p class="font-display font-bold">🥭 🌿 🥜 🍯</p>
            <p class="text-xs text-muted">6 crops, 1 proud country</p>
          </div>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="border-y border-ink/10 bg-white">
      <ul class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 py-10 sm:grid-cols-3 sm:px-6">
        {
          values.map((v) => (
            <li class="flex items-center gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-full bg-paper text-2xl">{v.icon}</span>
              <span class="font-display text-lg font-bold">
                {v.label}
                <span class="km text-base" lang="km">{v.labelKm}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- CROPS -->
    <section id="crops" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Our crops <span lang="km" class="font-khmer font-normal">· ដំណាំរបស់យើង</span></p>
      <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
        Six crops Cambodia is proud of.
      </h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ដំណាំប្រាំមួយមុខ ដែលកម្ពុជាមានមោទនភាព។</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          crops.map((c) => (
            <li class="rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl">
              <span class="text-4xl">{c.icon}</span>
              <h3 class="mt-4 font-display text-xl font-bold">
                {c.title}
                <span class="km text-base" lang="km">{c.titleKm}</span>
              </h3>
              <p class="mt-2 text-muted">
                {c.text}
                <span class="km" lang="km">{c.textKm}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- FIELD TO YOU -->
    <section id="how" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Field to you <span lang="km" class="font-khmer font-normal">· ពីចម្ការ ដល់អ្នក</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          From a Khmer farm to your table.
        </h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ពីកសិដ្ឋានខ្មែរ ដល់តុអាហាររបស់អ្នក។</p>
        <ol class="mt-12 grid gap-4 md:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="rounded-2xl bg-paper p-6">
                <div class="flex items-center justify-between">
                  <span class="text-3xl">{s.icon}</span>
                  <span class="font-display text-sm font-bold text-ink/30">0{i + 1}</span>
                </div>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {s.title}
                  <span class="km text-base" lang="km">{s.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {s.text}
                  <span class="km" lang="km">{s.textKm}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          When you choose Cambodian crops, you <span class="text-sun">support Khmer farmers</span> and their families.
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ពេលអ្នកជ្រើសរើសដំណាំខ្មែរ អ្នកគាំទ្រកសិករខ្មែរ និងគ្រួសាររបស់ពួកគេ។
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="text-center font-display text-4xl font-extrabold tracking-tight">Questions</h2>
      <p class="km mt-2 text-center text-xl font-semibold" lang="km">សំណួរ</p>
      <div class="mt-10 divide-y divide-ink/10 border-y border-ink/10">
        {
          faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
                <span>
                  {f.q}
                  <span class="km text-base" lang="km">{f.qKm}</span>
                </span>
                <span class="text-2xl text-brand transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-muted">
                {f.a}
                <span class="km" lang="km">{f.aKm}</span>
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="scroll-mt-20 px-4 pb-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Taste the best of Cambodia.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ភ្លក់រសជាតិល្អបំផុតរបស់កម្ពុជា។</p>
        <p class="mx-auto mt-4 max-w-xl text-paper/80">
          Message us to ask about our crops, prices and orders.
          <span class="km" lang="km">ផ្ញើសារមកយើង ដើម្បីសួរអំពីដំណាំ តម្លៃ និងការកុម្ម៉ង់។</span>
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={site.telegram} class="rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
            Message on Telegram <span lang="km" class="font-khmer font-normal opacity-70">ផ្ញើសារ</span>
          </a>
          <a href={site.phoneHref} class="rounded-full border border-paper/40 px-8 py-4 font-semibold transition hover:bg-paper/10">
            Call {site.phone}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
